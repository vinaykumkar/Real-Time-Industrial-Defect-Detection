# Real-Time Industrial Defect Detection System — example environment config
# Copy to .env and adjust as needed. Never commit real secrets.

# --- Model / backend ---------------------------------------------------
MODEL_PATH=models/best.pt
ONNX_MODEL_PATH=models/best.onnx
TENSORRT_MODEL_PATH=models/best.engine
# auto | pytorch | onnx   (TensorRT is used automatically only if a valid TRT engine exists)
INFERENCE_BACKEND=auto

# --- Real-time pipeline -------------------------------------------------
# Process every Nth captured frame (1 = all frames; 2 = half the load)
PROCESS_EVERY_N_FRAMES=1
# Temporal confirmation: REJECT only after defects in MIN_DEFECT_FRAMES of
# the last TEMPORAL_WINDOW processed frames (anti-flicker for PLC decisions)
TEMPORAL_WINDOW=3
MIN_DEFECT_FRAMES=2
# Debounce: minimum ms between two simulated PLC REJECT commands
PLC_REJECT_COOLDOWN_MS=2000

# --- Detection thresholds ----------------------------------------------
# Measured operating-point analysis (outputs/evaluation/final/threshold_analysis.json):
#   conf 0.25 -> P 0.683 / R 0.685 (recall-priority QC)
#   conf 0.35 -> P 0.754 / R 0.639 (best F1, balanced)  <-- default
#   conf 0.50 -> P 0.843 / R 0.539 (precision-priority)
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
# Confidence a detection must reach for the part to be REJECTED
PASS_REJECT_THRESHOLD=0.35

# --- Camera / video -----------------------------------------------------
CAMERA_SOURCE=0

# --- Storage ------------------------------------------------------------
DATABASE_PATH=data/detections.db
SAVE_DETECTIONS=true

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
